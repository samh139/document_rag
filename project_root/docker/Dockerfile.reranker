FROM python:3.11-slim
WORKDIR /workspace
COPY . /workspace
RUN apt-get update && apt-get install -y build-essential git \
  && pip install --upgrade pip
# Install minimal packages for reranker; the file requirements-reranker.txt will control exact versions
COPY requirements-reranker.txt /workspace/
RUN pip install -r requirements-reranker.txt
EXPOSE 5100
CMD ["python", "app/retrieval/jina_reranker_service.py"]
