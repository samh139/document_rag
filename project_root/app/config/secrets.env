########################################
# Elasticsearch
########################################
ES_CLUSTER_NAME=docsprawl-es
ES_HEAP=4g

# For applications to connect to ES inside Docker network
ES_HOST=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme


########################################
# Kafka / Zookeeper
########################################
KAFKA_BROKER_ID=1
KAFKA_LISTENERS=PLAINTEXT://:9092

# 🚨 MUST MATCH docker-compose (PLAINTEXT://kafka:9092)
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092

# For ingestion / reranker services
KAFKA_BOOTSTRAP_DOCKER=kafka:9092
KAFKA_BOOTSTRAP_LOCALHOST=localhost:9092
KAFKA_CHUNKS_TOPIC = dsprawl.chunks
KAFKA_EMBEDDED_TOPIC=dsprawl.embedded_chunks



########################################
# MinIO
########################################
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=dsprawl

# For application containers
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin


########################################
# MongoDB
########################################
MONGO_INITDB_ROOT_USERNAME=mongo_user
MONGO_INITDB_ROOT_PASSWORD=mongo_pass
MONGO_DB=docsprawl

# For application containers (correct internal URL)
MONGO_URI=mongodb://mongo_user:mongo_pass@mongo:27017


########################################
# Redis
########################################
REDIS_PASSWORD=


########################################
# Network
########################################
NETWORK_NAME=docsprawl_net
